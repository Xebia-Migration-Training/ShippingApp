<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="ShippingRules.MAUI.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:ShippingRules.MAUI.Views"
    Shell.FlyoutBehavior="Flyout"
    Title="Shipping Rules">

    <!-- Flyout Items -->
    <FlyoutItem Title="Shipping Rules" Icon="icon_rules.png">
        <ShellContent
            Title="Rules List"
            ContentTemplate="{DataTemplate views:RulesListPage}"
            Route="RulesListPage" />
    </FlyoutItem>

    <FlyoutItem Title="Create Rule" Icon="icon_add.png">
        <ShellContent
            Title="Create Rule"
            ContentTemplate="{DataTemplate views:CreateRulePage}"
            Route="CreateRulePage" />
    </FlyoutItem>

    <FlyoutItem Title="Validate Rule" Icon="icon_validate.png">
        <ShellContent
            Title="Validate"
            ContentTemplate="{DataTemplate views:ValidateRulePage}"
            Route="ValidateRulePage" />
    </FlyoutItem>

</Shell>
