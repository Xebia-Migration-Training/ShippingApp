<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:ShippingRules.MAUI.ViewModels"
             x:Class="ShippingRules.MAUI.Views.RulesListPage"
             Title="Shipping Rules"
             x:DataType="viewmodels:RulesListViewModel">

    <Grid RowDefinitions="Auto,Auto,*" Padding="20">
        
        <!-- Header -->
        <VerticalStackLayout Grid.Row="0" Spacing="10" Margin="0,0,0,20">
            <Label Text="Shipping Rules Management"
                   FontSize="28"
                   FontAttributes="Bold"
                   TextColor="{StaticResource Primary}" />
            <Label Text="Manage business rules with precedence logic"
                   FontSize="14"
                   TextColor="{StaticResource Gray600}" />
        </VerticalStackLayout>

        <!-- Action Buttons -->
        <HorizontalStackLayout Grid.Row="1" Spacing="10" Margin="0,0,0,10">
            <Button Text="Create New Rule"
                    Command="{Binding NavigateToCreateRuleCommand}"
                    BackgroundColor="{StaticResource Primary}"
                    TextColor="White"
                    CornerRadius="8"
                    Padding="20,10" />
            
            <Button Text="Validate Rule"
                    Command="{Binding NavigateToValidateRuleCommand}"
                    BackgroundColor="{StaticResource Secondary}"
                    TextColor="White"
                    CornerRadius="8"
                    Padding="20,10" />
            
            <Button Text="Refresh"
                    Command="{Binding RefreshCommand}"
                    BackgroundColor="{StaticResource Gray300}"
                    TextColor="Black"
                    CornerRadius="8"
                    Padding="20,10" />
            
            <CheckBox IsChecked="{Binding ShowActiveOnly}"
                      VerticalOptions="Center" />
            <Label Text="Active Only"
                   VerticalOptions="Center"
                   FontSize="14" />
        </HorizontalStackLayout>

        <!-- Rules List -->
        <ScrollView Grid.Row="2">
            <CollectionView ItemsSource="{Binding Rules}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame Margin="0,0,0,10"
                               Padding="15"
                               CornerRadius="8"
                               BorderColor="{StaticResource Gray200}"
                               HasShadow="True">
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto">
                                
                                <!-- Rule Name -->
                                <Label Grid.Row="0" Grid.Column="0"
                                       Text="{Binding RuleName}"
                                       FontSize="18"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource Primary}" />
                                
                                <!-- Precedence Badge -->
                                <Frame Grid.Row="0" Grid.Column="1"
                                       Padding="8,4"
                                       CornerRadius="12"
                                       BackgroundColor="{StaticResource Secondary}"
                                       HasShadow="False">
                                    <Label Text="{Binding PrecedenceLevel, StringFormat='Level {0}'}"
                                           FontSize="12"
                                           TextColor="White"
                                           FontAttributes="Bold" />
                                </Frame>

                                <!-- Description -->
                                <Label Grid.Row="1" Grid.ColumnSpan="2"
                                       Text="{Binding Description}"
                                       FontSize="14"
                                       TextColor="{StaticResource Gray600}"
                                       Margin="0,5,0,0" />

                                <!-- Rule Details -->
                                <HorizontalStackLayout Grid.Row="2" Grid.ColumnSpan="2" 
                                                      Spacing="15" 
                                                      Margin="0,10,0,0">
                                    <Label Text="{Binding RuleType}"
                                           FontSize="12"
                                           TextColor="{StaticResource Gray500}" />
                                    <Label Text="{Binding BaseRate, StringFormat='Rate: ${0:N2}'}"
                                           FontSize="12"
                                           TextColor="{StaticResource Gray500}" />
                                    <Label Text="{Binding SurchargePercentage, StringFormat='Surcharge: {0:N1}%'}"
                                           FontSize="12"
                                           TextColor="{StaticResource Gray500}" />
                                </HorizontalStackLayout>

                                <!-- Dates -->
                                <HorizontalStackLayout Grid.Row="3" Grid.ColumnSpan="2" 
                                                      Spacing="10" 
                                                      Margin="0,5,0,0">
                                    <Label Text="{Binding EffectiveFrom, StringFormat='From: {0:MMM dd, yyyy}'}"
                                           FontSize="11"
                                           TextColor="{StaticResource Gray400}" />
                                    <Label Text="{Binding EffectiveTo, StringFormat='To: {0:MMM dd, yyyy}'}"
                                           FontSize="11"
                                           TextColor="{StaticResource Gray400}"
                                           IsVisible="{Binding EffectiveTo, Converter={StaticResource IsNotNullConverter}}" />
                                </HorizontalStackLayout>

                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                
                <CollectionView.EmptyView>
                    <VerticalStackLayout VerticalOptions="Center" 
                                        HorizontalOptions="Center"
                                        Padding="50">
                        <Label Text="No rules found"
                               FontSize="18"
                               TextColor="{StaticResource Gray400}"
                               HorizontalTextAlignment="Center" />
                        <Label Text="Create a new rule to get started"
                               FontSize="14"
                               TextColor="{StaticResource Gray300}"
                               HorizontalTextAlignment="Center"
                               Margin="0,10,0,0" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
            </CollectionView>
        </ScrollView>

        <!-- Loading Indicator -->
        <ActivityIndicator Grid.RowSpan="3"
                          IsRunning="{Binding IsLoading}"
                          IsVisible="{Binding IsLoading}"
                          HorizontalOptions="Center"
                          VerticalOptions="Center"
                          Color="{StaticResource Primary}" />
    </Grid>
</ContentPage>
