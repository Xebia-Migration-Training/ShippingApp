<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:ShippingRules.MAUI.ViewModels"
             x:Class="ShippingRules.MAUI.Views.CreateRulePage"
             Title="Create Shipping Rule"
             x:DataType="viewmodels:CreateRuleViewModel">

    <ScrollView Padding="20">
        <VerticalStackLayout Spacing="15">
            
            <Label Text="Create New Shipping Rule"
                   FontSize="24"
                   FontAttributes="Bold"
                   TextColor="{StaticResource Primary}" />

            <!-- Rule Name -->
            <VerticalStackLayout Spacing="5">
                <Label Text="Rule Name *" FontSize="14" FontAttributes="Bold" />
                <Entry Text="{Binding RuleName}"
                       Placeholder="Enter rule name"
                       MaxLength="200" />
            </VerticalStackLayout>

            <!-- Description -->
            <VerticalStackLayout Spacing="5">
                <Label Text="Description *" FontSize="14" FontAttributes="Bold" />
                <Editor Text="{Binding Description}"
                        Placeholder="Enter description"
                        HeightRequest="100"
                        MaxLength="1000" />
            </VerticalStackLayout>

            <!-- Precedence Level -->
            <VerticalStackLayout Spacing="5">
                <Label Text="Precedence Level *" FontSize="14" FontAttributes="Bold" />
                <Picker ItemsSource="{Binding PrecedenceLevels}"
                        SelectedItem="{Binding PrecedenceLevel}"
                        Title="Select precedence level" />
                <Label Text="1=Vessel, 2=Port, 3=Principal, 4=Country, 5=Global"
                       FontSize="11"
                       TextColor="{StaticResource Gray400}" />
            </VerticalStackLayout>

            <!-- Rule Type -->
            <VerticalStackLayout Spacing="5">
                <Label Text="Rule Type *" FontSize="14" FontAttributes="Bold" />
                <Picker ItemsSource="{Binding RuleTypes}"
                        SelectedItem="{Binding RuleType}"
                        Title="Select rule type" />
            </VerticalStackLayout>

            <!-- Category -->
            <VerticalStackLayout Spacing="5">
                <Label Text="Category" FontSize="14" FontAttributes="Bold" />
                <Entry Text="{Binding RuleCategory}"
                       Placeholder="Enter category" />
            </VerticalStackLayout>

            <!-- Base Rate -->
            <VerticalStackLayout Spacing="5">
                <Label Text="Base Rate ($) *" FontSize="14" FontAttributes="Bold" />
                <Entry Text="{Binding BaseRate}"
                       Placeholder="0.00"
                       Keyboard="Numeric" />
            </VerticalStackLayout>

            <!-- Surcharge Percentage -->
            <VerticalStackLayout Spacing="5">
                <Label Text="Surcharge (%) *" FontSize="14" FontAttributes="Bold" />
                <Entry Text="{Binding SurchargePercentage}"
                       Placeholder="0.00"
                       Keyboard="Numeric" />
            </VerticalStackLayout>

            <!-- Effective From -->
            <VerticalStackLayout Spacing="5">
                <Label Text="Effective From *" FontSize="14" FontAttributes="Bold" />
                <DatePicker Date="{Binding EffectiveFrom}"
                           Format="MMM dd, yyyy" />
            </VerticalStackLayout>

            <!-- Effective To -->
            <VerticalStackLayout Spacing="5">
                <Label Text="Effective To (Optional)" FontSize="14" FontAttributes="Bold" />
                <DatePicker Date="{Binding EffectiveTo}"
                           Format="MMM dd, yyyy" />
            </VerticalStackLayout>

            <!-- Requires Approval -->
            <HorizontalStackLayout Spacing="10">
                <CheckBox IsChecked="{Binding RequiresApproval}" />
                <Label Text="Requires Approval"
                       VerticalOptions="Center"
                       FontSize="14" />
            </HorizontalStackLayout>

            <!-- Action Buttons -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,20,0,0">
                <Button Grid.Column="0"
                        Text="Cancel"
                        Command="{Binding CancelCommand}"
                        BackgroundColor="{StaticResource Gray300}"
                        TextColor="Black"
                        CornerRadius="8" />
                
                <Button Grid.Column="1"
                        Text="Create Rule"
                        Command="{Binding CreateRuleCommand}"
                        BackgroundColor="{StaticResource Primary}"
                        TextColor="White"
                        CornerRadius="8"
                        IsEnabled="{Binding IsSubmitting, Converter={StaticResource InvertedBoolConverter}}" />
            </Grid>

            <!-- Loading Indicator -->
            <ActivityIndicator IsRunning="{Binding IsSubmitting}"
                              IsVisible="{Binding IsSubmitting}"
                              Color="{StaticResource Primary}"
                              Margin="0,10,0,0" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
