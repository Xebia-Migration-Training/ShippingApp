<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:ShippingRules.MAUI.ViewModels"
             x:Class="ShippingRules.MAUI.Views.ValidateRulePage"
             Title="Validate Rule Precedence"
             x:DataType="viewmodels:ValidateRuleViewModel">

    <ScrollView Padding="20">
        <VerticalStackLayout Spacing="20">
            
            <Label Text="Find Applicable Rule"
                   FontSize="24"
                   FontAttributes="Bold"
                   TextColor="{StaticResource Primary}" />

            <Label Text="Enter criteria to find the most applicable rule based on precedence logic"
                   FontSize="14"
                   TextColor="{StaticResource Gray600}" />

            <!-- Search Criteria (Simplified - IDs only) -->
            <Frame Padding="15" CornerRadius="8" BorderColor="{StaticResource Gray200}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Search Criteria" FontSize="16" FontAttributes="Bold" />
                    
                    <Entry Placeholder="Country ID (optional)"
                           Text="{Binding SelectedCountryId}"
                           Keyboard="Text" />
                    
                    <Entry Placeholder="Port ID (optional)"
                           Text="{Binding SelectedPortId}"
                           Keyboard="Text" />
                    
                    <Entry Placeholder="Vessel ID (optional)"
                           Text="{Binding SelectedVesselId}"
                           Keyboard="Text" />
                    
                    <Entry Placeholder="Principal ID (optional)"
                           Text="{Binding SelectedPrincipalId}"
                           Keyboard="Text" />
                </VerticalStackLayout>
            </Frame>

            <!-- Action Buttons -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <Button Grid.Column="0"
                        Text="Clear"
                        Command="{Binding ClearSelectionCommand}"
                        BackgroundColor="{StaticResource Gray300}"
                        TextColor="Black"
                        CornerRadius="8" />
                
                <Button Grid.Column="1"
                        Text="Find Rule"
                        Command="{Binding FindApplicableRuleCommand}"
                        BackgroundColor="{StaticResource Primary}"
                        TextColor="White"
                        CornerRadius="8" />
            </Grid>

            <!-- Validation Message -->
            <Frame IsVisible="{Binding ValidationMessage, Converter={StaticResource IsNotNullOrEmptyConverter}}"
                   Padding="15"
                   CornerRadius="8"
                   BackgroundColor="{StaticResource Gray100}">
                <Label Text="{Binding ValidationMessage}"
                       FontSize="14"
                       TextColor="{StaticResource Gray900}" />
            </Frame>

            <!-- Applicable Rule Details -->
            <Frame IsVisible="{Binding ApplicableRule, Converter={StaticResource IsNotNullConverter}}"
                   Padding="20"
                   CornerRadius="12"
                   BorderColor="{StaticResource Primary}"
                   HasShadow="True">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Applicable Rule Found!"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Primary}" />

                    <Label Text="{Binding ApplicableRule.RuleName}"
                           FontSize="20"
                           FontAttributes="Bold" />

                    <Label Text="{Binding ApplicableRule.Description}"
                           FontSize="14"
                           TextColor="{StaticResource Gray600}" />

                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="8">
                        <Label Grid.Row="0" Grid.Column="0" Text="Precedence Level:" FontAttributes="Bold" />
                        <Label Grid.Row="0" Grid.Column="1" Text="{Binding ApplicableRule.PrecedenceLevel}" />

                        <Label Grid.Row="1" Grid.Column="0" Text="Rule Type:" FontAttributes="Bold" />
                        <Label Grid.Row="1" Grid.Column="1" Text="{Binding ApplicableRule.RuleType}" />

                        <Label Grid.Row="2" Grid.Column="0" Text="Base Rate:" FontAttributes="Bold" />
                        <Label Grid.Row="2" Grid.Column="1" Text="{Binding ApplicableRule.BaseRate, StringFormat='${0:N2}'}" />

                        <Label Grid.Row="3" Grid.Column="0" Text="Surcharge:" FontAttributes="Bold" />
                        <Label Grid.Row="3" Grid.Column="1" Text="{Binding ApplicableRule.SurchargePercentage, StringFormat='{0:N1}%'}" />
                    </Grid>

                    <Label Text="{Binding ApplicableRule.EffectiveFrom, StringFormat='Effective From: {0:MMMM dd, yyyy}'}"
                           FontSize="12"
                           TextColor="{StaticResource Gray500}"
                           Margin="0,10,0,0" />
                </VerticalStackLayout>
            </Frame>

            <!-- Loading Indicator -->
            <ActivityIndicator IsRunning="{Binding IsSearching}"
                              IsVisible="{Binding IsSearching}"
                              Color="{StaticResource Primary}" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
