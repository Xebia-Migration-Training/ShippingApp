@page "/"

<PageTitle>Shipping Rules Management</PageTitle>

<div class="container mt-5">
    <div class="text-center mb-5">
        <h1>Shipping Rules Management System</h1>
        <p class="lead">Manage business rules with precedence logic</p>
    </div>

    <div class="row g-4">
        <div class="col-md-4">
            <div class="card h-100">
                <div class="card-body text-center">
                    <h5 class="card-title">📋 View Rules</h5>
                    <p class="card-text">Browse all shipping rules with filters and search</p>
                    <a href="/rules" class="btn btn-primary">View Rules</a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100">
                <div class="card-body text-center">
                    <h5 class="card-title">➕ Create Rule</h5>
                    <p class="card-text">Add new shipping rules with precedence levels</p>
                    <a href="/create-rule" class="btn btn-success">Create New</a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100">
                <div class="card-body text-center">
                    <h5 class="card-title">✓ Validate Rule</h5>
                    <p class="card-text">Test precedence logic and find applicable rules</p>
                    <a href="/validate-rule" class="btn btn-info">Validate</a>
                </div>
            </div>
        </div>
    </div>
</div>
